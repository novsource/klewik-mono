{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2018",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "CommonJS",
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noEmit": true,
    "outDir": "./dist",
  },
  "include": [
    "."
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "**/*.meta.ts",
    "**/*.spec.ts"
  ],
  "extends": "./tsconfig.paths.json",
}
