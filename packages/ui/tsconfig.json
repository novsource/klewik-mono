{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2018",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "emitDeclarationOnly": false,
    "strict": true,
    "module": "CommonJS",
  },
  "include": [
    "."
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.config.js",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "**/*.meta.ts",
    "**/*.spec.ts"
  ],
}
