{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2018",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "emitDeclarationOnly": false,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "experimentalDecorators": true
  },
  "include": [
    "."
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.config.js",
    "**/*.meta.ts",
    "**/*.spec.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.storybook.json"
    }
  ]
}
