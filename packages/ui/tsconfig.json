{
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "skipLibCheck": true,
    "rootDir": "./src",
    "composite": true
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules",
    "**/*.config.js",
    "**/*.json",
    "**/*.meta.ts",
    "**/*.spec.ts",
    "**/*.stories.tsx",
    "**/*.stories.ts",
  ]
}
