{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "preserveSymlinks": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "react"
    ],
    "paths": {
      "~public/*": [
        "./public/*"
      ],
      "~lib/*": [
        "./src/lib/*"
      ],
      "~context/*": [
        "./src/context/*"
      ],
      "~hooks/*": [
        "./src/hooks/*"
      ],
      "~utils/*": [
        "./src/utils/*"
      ],
      "~ui/*": [
        "./src/ui/*"
      ],
      "~/*": [
        "./src/*"
      ],
      "contentlayer/generated": [
        "./.contentlayer/generated"
      ]
    }
  },
  "include": [
    "svgr.d.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".contentlayer/generated",
    "tailwindcss.config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
