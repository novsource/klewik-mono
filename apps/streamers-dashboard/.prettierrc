{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "importOrder": [
    "^react",
    "<THIRD_PARTY_MODULES>",
    "^~app/(.*)$",
    "^~pages/(.*)$",
    "^~widgets/(.*)$",
    "^~features/(.*)$",
    "^~entities/auction/(.*)$",
    "^~entities/auction-slot/(.*)$",
    "^~entities/donation/(.*)$",
    "^~entities/wheel/(.*)$",
    "^~entities/integrations/(.*)$",
    "^~entities/(.*)$",
    "^~ui/(.*)$",
    "^~shared/api/(.*)$",
    "^~shared/store/(.*)$",
    "^~shared/router/(.*)$",
    "^~shared/lib/(.*)$",
    "^~shared/hooks/(.*)$",
    "^~shared/ui/(.*)$",
    "^~shared/utils/(.*)$",
    "^~shared/constants/(.*)$",
    "^~shared/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "tailwindStylesheet": "./src/app/styles/index.css",
  "tailwindFunctions": ["clsx", "cva", "cn"],
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss",
  ]
}
