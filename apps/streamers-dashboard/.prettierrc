{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "importOrder": [
    "^react",
    "<THIRD_PARTY_MODULES>",
    "^~app/(.*)$",
    "^~pages/(.*)$",
    "^~widgets/(.*)$",
    "^~features/(.*)$",
    "^~entities/(.*)$",
    "^~ui/(.*)$",
    "^~shared/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": [
    "prettier-plugin-tailwindcss",
    "@trivago/prettier-plugin-sort-imports"
  ]
}
