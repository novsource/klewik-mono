{
  "extends": [
    "./tsconfig.paths.json",
  ],
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    /* Alias */
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@ui/*": [
        "./src/shared/components/ui/*"
      ],
      "@root/*": [
        "./*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
}
